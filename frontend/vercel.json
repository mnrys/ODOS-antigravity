{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://odos-backend-j2d3.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://odos-backend-j2d3.onrender.com/uploads/:path*"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://odos-backend-j2d3.onrender.com/ai/:path*"
    },
    {
      "source": "/activities/quick-capture/:path*",
      "destination": "https://odos-backend-j2d3.onrender.com/activities/quick-capture/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
