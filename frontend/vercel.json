{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://VOTRE_URL_RENDER/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://VOTRE_URL_RENDER/uploads/:path*"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://VOTRE_URL_RENDER/ai/:path*"
    },
    {
      "source": "/activities/quick-capture/:path*",
      "destination": "https://VOTRE_URL_RENDER/activities/quick-capture/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
