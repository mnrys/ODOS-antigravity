# ==========================================
# ODOS Travel Planner - Variables d'environnement
# ==========================================

# Jeton personnel API Apify (obtenu sur https://console.apify.com/account#/integrations)
APIFY_API_TOKEN=apify_api_votre_token_ici

# Identifiant de l'Actor Apify pour GetYourGuide
# Par défaut : automation-lab/getyourguide-activities-scraper
APIFY_GYG_ACTOR_ID=automation-lab/getyourguide-activities-scraper

# Clé API Firecrawl pour le scraping TripAdvisor (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-votre_cle_ici

# ==========================================
# Base de données & Stockage (Supabase)
# ==========================================

# URL de connexion à la base de données PostgreSQL (Supabase)
# Par défaut, SQLite local est utilisé si cette variable n'est pas définie.
DATABASE_URL=postgresql://postgres.xxx:[MOT_DE_PASSE]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# Clés d'API pour l'envoi des photos vers Supabase Storage
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre_cle_anon_ou_service_role
